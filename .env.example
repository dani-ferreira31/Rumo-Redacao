# ---- Banco ----
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=rumo1000
DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/rumo1000
TEST_DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/rumo1000_test

# ---- App ----
JWT_SECRET=troque-isto
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
COOKIE_SECURE=false            # true em produção (HTTPS)

# ---- Portas expostas no host (dev) ----
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ---- IA (Anthropic) ----
AI_DRIVER=fake                 # padrão quando o painel não configurou: fake (sem custo) | anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_TRANSCRIPTION=claude-sonnet-5-5
ANTHROPIC_MODEL_GRADING=claude-sonnet-5-5
ANTHROPIC_EFFORT_TRANSCRIPTION=medium
ANTHROPIC_EFFORT_GRADING=high
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Criptografa as chaves de API salvas pelo painel admin (gere uma por servidor e guarde no backup).
SETTINGS_ENCRYPTION_KEY=

# ---- E-mail ----
EMAIL_DRIVER=console           # console | resend
RESEND_API_KEY=
EMAIL_FROM="Rumo1000 <nao-responda@seudominio.com.br>"

# ---- Storage (disco local, também em produção) ----
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/data/storage

# ---- Worker ----
WORKER_POLL_INTERVAL=1.0

# ---- Seed (scripts/seed.py) ----
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=troque-esta-senha
