# Copie para .env.prod e preencha. Nunca versione o .env.prod.
DOMAIN=rumo1000.seudominio.com.br

POSTGRES_USER=app
POSTGRES_PASSWORD=gere-uma-senha-forte
POSTGRES_DB=rumo1000
DATABASE_URL=postgresql+asyncpg://app:gere-uma-senha-forte@postgres:5432/rumo1000

# gere com: openssl rand -hex 32
JWT_SECRET=
APP_URL=https://rumo1000.seudominio.com.br
API_URL=https://rumo1000.seudominio.com.br
COOKIE_SECURE=true

AI_DRIVER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_TRANSCRIPTION=claude-sonnet-5-5
ANTHROPIC_MODEL_GRADING=claude-sonnet-5-5
ANTHROPIC_EFFORT_TRANSCRIPTION=medium
ANTHROPIC_EFFORT_GRADING=high
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Criptografa as chaves de API salvas pelo painel admin (gere uma por servidor e guarde no backup).
SETTINGS_ENCRYPTION_KEY=

EMAIL_DRIVER=resend
RESEND_API_KEY=
EMAIL_FROM="Rumo1000 <nao-responda@seudominio.com.br>"

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/data/storage
LOG_LEVEL=INFO

# Backup diário às BACKUP_HOUR (fuso de São Paulo), guardando BACKUP_KEEP_DAYS dias
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14

# Admin inicial (scripts/seed.py). Troque a senha depois do primeiro login.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
