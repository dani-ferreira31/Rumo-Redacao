# HTTPS automático (Let's Encrypt) para o domínio em $DOMAIN.
# Front e API ficam na mesma origem: /api/* e /health vão para o backend.
{$DOMAIN} {
	encode zstd gzip

	@api path /api/* /health
	handle @api {
		# fotos de redação podem ter até 10 MB cada (2 por envio)
		request_body {
			max_size 25MB
		}
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		-Server
	}

	log {
		output stdout
		format json
	}
}
